# GEARAWAI — copy to .env.local and fill in values from Supabase → Project Settings → API.
# Only public values belong here. NEVER put the service_role / secret key in this app (DATABASE_DESIGN §1).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon key or the new publishable key (sb_publishable_...) both work.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# D-25 — base URL for Supabase Auth e-mail links (Forgot Password). Server-only, no NEXT_PUBLIC_ prefix.
# Local: optional, defaults to http://localhost:3000 (only localhost / 127.0.0.1 are accepted).
# Vercel Production: https://gearawai.vercel.app is the only host accepted there; when unset, Vercel's
# VERCEL_PROJECT_PRODUCTION_URL is used instead. Preview deployments never send reset e-mails.
SITE_URL=http://localhost:3000
